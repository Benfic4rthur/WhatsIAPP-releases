{
  "name": "whatsiapp",
  "version": "1.0.18",
  "main": "main-updater.js",
  "scripts": {
    "test": "node --check main-updater.js && node --check sessao-whatsapp.js && node --check desktop-updater.js && node --check updater-core.js && node --check index.js && node --check whatsapp-worker.js && node --check whatsapp-worker-live-wrapper.js && node --check wpp-worker.js && node --check renderer-modules/versao-app.js && node --check renderer-modules/ajustes-conversa-sessao.js && node --check renderer-modules/anexos.js && node --check renderer-modules/audio.js && node --check renderer-modules/eventos-whatsapp.js && node --check renderer-modules/lista-conversas.js && node --check renderer-modules/renderizacao-mensagens.js && node --check renderer-modules/compositor-mensagens.js && node --check scripts/logout-whatsapp-helper-v2.js && node scripts/testar-updater.js && node scripts/testar-status-entrega.js && node scripts/testar-midias.js && node scripts/testar-cartoes.js",
    "start": "electron .",
    "doctor": "node scripts/diagnostico-ambiente.js",
    "clean:dist": "node scripts/limpar-dist-local.js",
    "prepare:icon": "node scripts/preparar-icone-macos.js assets/logo.png assets/logo-macos.png",
    "prepare:chrome": "node scripts/preparar-chrome-empacotado.js",
    "dist:mac": "npm run clean:dist && npm run prepare:icon && npm run prepare:chrome && electron-builder --mac --publish never",
    "dist:win": "node scripts/gerar-windows.js",
    "test:windows-packaging": "node scripts/testar-empacotamento-windows.js",
    "release:mac": "npm run clean:dist && npm run prepare:icon && npm run prepare:chrome && electron-builder --mac --publish onTag",
    "postinstall": "node scripts/aplicar-patches-whatsiapp.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Benfic4rthur/WhatsIAPP-releases.git"
  },
  "publish": {
    "provider": "github",
    "owner": "Benfic4rthur",
    "repo": "WhatsIAPP-releases"
  },
  "description": "Assistente desktop inteligente para WhatsApp",
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.24",
    "@wppconnect-team/wppconnect": "^2.2.6",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "1.1.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^26.15.3"
  },
  "productName": "WhatsIAPP",
  "build": {
    "appId": "com.whatsiapp.desktop",
    "productName": "WhatsIAPP",
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.js",
      "app.html",
      "package.json",
      "style.css",
      "assets/**/*",
      "renderer-modules/**/*.js",
      "wpp-worker-modules/**/*.js",
      "styles/**/*.css",
      "scripts/**/*.js",
      "testador-mestre/**/*",
      "!dist/**/*",
      "!tokens/**/*",
      "!.wwebjs_auth/**/*",
      "!.wwebjs_cache/**/*",
      "!build/wppconnect-chrome/**/*",
      "!**/storageState.json",
      "!**/creds.json",
      "!**/conversas.json",
      "!**/.env*"
    ],
    "win": {
      "icon": "assets/logo.png",
      "artifactName": "WhatsIAPP-Setup-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "assets/logo-macos.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false
    },
    "dmg": {
      "title": "WhatsIAPP",
      "icon": "assets/logo-macos.png",
      "backgroundColor": "#0b0e11"
    },
    "asarUnpack": [
      "**/*.node",
      "node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "build/wppconnect-chrome",
        "to": "wppconnect-chrome"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WhatsIAPP"
    }
  }
}
